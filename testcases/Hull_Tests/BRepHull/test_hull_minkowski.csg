hull() {
	minkowski(convexity = 0) {
		cube(size = [30, 20, 3], center = true);
		cylinder($fn = 32, $fa = 12, $fs = 2, h = 1, r1 = 2, r2 = 2, center = true);
	}
	multmatrix([[1, 0, 0, 0], [0, 1, 0, 20], [0, 0, 1, 10], [0, 0, 0, 1]]) {
		minkowski(convexity = 0) {
			cube(size = [16, 12, 12], center = true);
			cylinder($fn = 32, $fa = 12, $fs = 2, h = 1, r1 = 1.5, r2 = 1.5, center = true);
		}
	}
}

